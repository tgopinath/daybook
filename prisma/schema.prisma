// Personal AI Dashboard — data model.
// Every user-owned row carries userId with an index and ON DELETE CASCADE,
// so deleting a user removes all of their data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GoalStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ABANDONED
}

enum Recurrence {
  NONE
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
}

enum NotificationType {
  REMINDER
  TASK_OVERDUE
  GOAL_MILESTONE
  HABIT
  CALENDAR
  AI
  SYSTEM
}

enum AIRole {
  USER
  ASSISTANT
  TOOL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // bcrypt hash; accounts created through Google sign-in hold a non-bcrypt marker until a password is set
  passwordHash String
  googleId     String?  @unique // Google account "sub", set on first Google sign-in
  // Two-step verification (authenticator app, RFC 6238 TOTP). Secret is AES-GCM encrypted.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  settings          UserSettings?
  tasks             Task[]
  goals             Goal[]
  reminders         Reminder[]
  events            CalendarEvent[]
  habits            Habit[]
  notes             Note[]
  tags              Tag[]
  categories        Category[]
  projects          Project[]
  notifications     Notification[]
  attachments       Attachment[]
  vaultItems        VaultItem[]
  conversations     AIConversation[]
  pushSubscriptions PushSubscription[]
  recentSearches    RecentSearch[]
  media             MediaFile[]
  journalEntries    JournalEntry[]
  gratitudeEntries  GratitudeEntry[]
  moodEntries       MoodEntry[]
  albums            Album[]
  memories          Memory[]
  photoCollections  PhotoCollection[]
  photos            PhotoEntry[]
  bucketItems       BucketItem[]
  timelineEvents    TimelineEvent[]
  weeklyReviews     WeeklyReview[]
  financeAccounts   FinanceAccount[]
  transactions      Transaction[]
  budgets           Budget[]
  driveFolders      DriveFolder[]
  driveFiles        DriveFile[]
  backupCodes       BackupCode[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  timezone             String   @default("UTC")
  language             String   @default("en")
  theme                String   @default("system") // light | dark | system
  accentColor          String   @default("#993399")
  density              String   @default("comfortable") // comfortable | compact
  defaultPriority      Priority @default(MEDIUM)
  workStart            String   @default("09:00")
  workEnd              String   @default("18:00")
  weekStart            Int      @default(1) // 0 = Sunday, 1 = Monday
  dailyFocus           String?
  dailyFocusDate       String?  // yyyy-MM-dd the focus statement belongs to
  planningTime         String   @default("08:30")
  browserNotifications Boolean  @default(true)
  emailNotifications   Boolean  @default(false)
  reminderLeadMinutes  Int      @default(0)
  defaultSnoozeMinutes Int      @default(10)
  notifyOverdue        Boolean  @default(true)
  notifyHabits         Boolean  @default(true)
  notifyCalendar       Boolean  @default(true)
  notifyAI             Boolean  @default(true)
  // WhatsApp reminders (Meta WhatsApp Cloud API). The number is E.164 digits without "+".
  whatsappNumber       String?
  whatsappVerified     Boolean  @default(false)
  whatsappReminders    Boolean  @default(false)
  whatsappCodeHash     String?  // HMAC of the pending 6-digit verification code
  whatsappCodeExpires  DateTime?
  whatsappCodeAttempts Int      @default(0)
  // Overview widgets: ordered list of {id, visible}; null = default layout
  dashboardWidgets     Json?
  // Google Photos Picker: short-lived access token (encrypted) for importing picked photos
  googlePhotosTokenEnc     String?
  googlePhotosTokenExpires DateTime?
  // Google Drive / Sheets (drive.file scope): short-lived access token, encrypted
  googleDriveTokenEnc      String?
  googleDriveTokenExpires  DateTime?
  // Money
  currency             String   @default("INR") // ISO 4217
  // App lock: a PIN asked after inactivity (bcrypt hash); 0 minutes = off
  appLockPinHash       String?
  appLockMinutes       Int      @default(0)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  color     String          @default("#635BFF")
  kind      String          @default("general") // general | task | goal | event | note | vault
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  events    CalendarEvent[]
  notes     Note[]

  @@unique([userId, name, kind])
  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#635BFF")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([userId, name])
  @@index([userId])
}

model Tag {
  id     String    @id @default(cuid())
  userId String
  name   String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  TaskTag[]
  notes  NoteTag[]
  journalEntries JournalTag[]

  @@unique([userId, name])
  @@index([userId])
}

model Task {
  id             String        @id @default(cuid())
  userId         String
  title          String
  description    String?
  dueDate        DateTime?
  startTime      String?       // HH:mm
  endTime        String?       // HH:mm
  priority       Priority      @default(MEDIUM)
  status         TaskStatus    @default(NOT_STARTED)
  categoryId     String?
  projectId      String?
  goalId         String?
  milestoneId    String?
  eventId        String?
  recurrence     Recurrence    @default(NONE)
  recurrenceRule String?       // e.g. "every 2 days" / interval JSON for CUSTOM
  reminderAt     DateTime?
  focusRank      Int?          // 1..3 when pinned to Today's Focus
  sortOrder      Float         @default(0)
  completedAt    DateTime?
  archivedAt     DateTime?
  deletedAt      DateTime?
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  event          CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  subtasks       Subtask[]
  tags           TaskTag[]
  attachments    Attachment[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, deletedAt])
  @@index([goalId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Attachment {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  fileName  String
  mimeType  String
  size      Int
  storageKey String  // path inside the private storage root; never served publicly
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}

model Goal {
  id           String      @id @default(cuid())
  userId       String
  title        String
  description  String?
  category     String      @default("Personal") // Fitness | Career | Financial | Learning | Personal | Family | Business
  startDate    DateTime    @default(now())
  targetDate   DateTime?
  targetValue  Float?
  currentValue Float       @default(0)
  unit         String?
  notes        String?
  status       GoalStatus  @default(ACTIVE)
  color        String      @default("#635BFF")
  archivedAt   DateTime?
  deletedAt    DateTime?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones   Milestone[]
  tasks        Task[]
  progressLogs GoalProgress[]

  @@index([userId, status])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  dueDate     DateTime?
  done        Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([goalId])
}

// Snapshot of goal value changes, used for the weekly progress chart.
model GoalProgress {
  id        String   @id @default(cuid())
  goalId    String
  value     Float
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model Reminder {
  id              String         @id @default(cuid())
  userId          String
  title           String
  notes           String?
  kind            String         @default("custom") // water | break | meeting | bill | family | deadline | routine | custom
  remindAt        DateTime       // next time this reminder fires
  recurrence      Recurrence     @default(NONE)
  intervalMinutes Int?           // for HOURLY / CUSTOM, e.g. 120 = every two hours
  daysOfWeek      Int[]          @default([]) // 0..6 for WEEKLY/CUSTOM
  endsAt          DateTime?
  status          ReminderStatus @default(ACTIVE)
  snoozedUntil    DateTime?
  lastFiredAt     DateTime?
  taskId          String?
  eventId         String?
  habitId         String?
  archivedAt      DateTime?
  deletedAt       DateTime?
  isDemo          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  habit           Habit?         @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
  @@index([status, remindAt])
}

model CalendarEvent {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  location    String?
  start       DateTime
  end         DateTime
  allDay      Boolean    @default(false)
  kind        String     @default("event") // event | meeting | personal | birthday | important
  color       String?
  categoryId  String?
  recurrence  Recurrence @default(NONE)
  deletedAt   DateTime?
  isDemo      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks       Task[]
  reminders   Reminder[]

  @@index([userId, start])
}

model Habit {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String       @default("check")
  color       String       @default("#635BFF")
  frequency   String       @default("daily") // daily | weekly
  daysOfWeek  Int[]        @default([0, 1, 2, 3, 4, 5, 6])
  targetPerDay Int         @default(1)
  reminderTime String?     // HH:mm
  archivedAt  DateTime?
  deletedAt   DateTime?
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     HabitEntry[]
  reminders   Reminder[]

  @@index([userId])
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  date      String   // yyyy-MM-dd in the user's timezone
  count     Int      @default(1)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

model Note {
  id          String    @id @default(cuid())
  userId      String
  title       String    @default("Untitled")
  content     Json      // TipTap JSON document
  plainText   String    @default("") // denormalised for search
  categoryId  String?
  pinned      Boolean   @default(false)
  favorite    Boolean   @default(false)
  archivedAt  DateTime?
  deletedAt   DateTime?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        NoteTag[]

  @@index([userId, updatedAt])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

// Personal information vault. `fields` is AES-256-GCM ciphertext of a JSON
// array of {label, value, sensitive}; the title and category stay searchable.
model VaultItem {
  id         String    @id @default(cuid())
  userId     String
  category   String    // Profile | Emergency contact | Phone | Address | Family | Important date | Vehicle | Insurance | Subscription | Document | Custom
  title      String
  fieldsEnc  String
  deletedAt  DateTime?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String?
  link       String?          // in-app route, never contains private data
  sourceId   String?          // id of the reminder/task/etc. that produced it
  readAt     DateTime?
  snoozedUntil DateTime?
  delivered  Boolean          @default(false) // pushed to a device
  whatsappSent Boolean        @default(false) // also sent as a WhatsApp message
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, createdAt])
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String      @default("New conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AIRole
  content        String
  // Tool calls the model proposed, plus their execution state:
  // [{id, name, input, status: "pending"|"confirmed"|"rejected"|"done", result}]
  toolCalls      Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================================
// Phase 1 — personal journaling, memories and wellness
// ============================================================================

// An uploaded file (photo, video, audio or document) in object storage.
// Rows link to it through join tables; the bytes never live in Postgres.
model MediaFile {
  id           String    @id @default(cuid())
  userId       String
  kind         String    // image | video | audio | document
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  durationSec  Float?
  storageKey   String    @unique // object key inside the media bucket / storage dir
  originalName String?
  source       String    @default("upload") // upload | google_photos
  sourceId     String?   // e.g. Google Photos media item id (dedupe imports)
  takenAt      DateTime? // capture time when known (EXIF / Google Photos)
  status       String    @default("pending") // pending (upload started) | ready
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal      JournalMedia[]
  memories     MemoryMedia[]
  photos       PhotoEntry[]
  bucketItems  BucketItem[]
  timeline     TimelineMedia[]
  albumCovers  Album[]   @relation("AlbumCover")
  receipts     Transaction[]
  driveFiles   DriveFile[]

  @@index([userId, createdAt])
  @@index([userId, source, sourceId])
}

model JournalEntry {
  id          String    @id @default(cuid())
  userId      String
  title       String    @default("")
  content     Json      // TipTap JSON document
  plainText   String    @default("")
  entryDate   String    // yyyy-MM-dd in the user's timezone (calendar browsing)
  mood        String?   // happy | excited | calm | neutral | sad | anxious | stressed | angry
  isPrivate   Boolean   @default(false) // private: excluded from search previews and AI
  isDraft     Boolean   @default(true)
  pinned      Boolean   @default(false)
  wordCount   Int       @default(0)
  archivedAt  DateTime?
  deletedAt   DateTime?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        JournalTag[]
  media       JournalMedia[]
  moodEntries MoodEntry[]

  @@index([userId, entryDate])
  @@index([userId, deletedAt, updatedAt])
}

model JournalTag {
  entryId String
  tagId   String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
}

model JournalMedia {
  entryId   String
  mediaId   String
  sortOrder Int          @default(0)
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  media     MediaFile    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([entryId, mediaId])
}

// Three things to be grateful for, one row per day.
model GratitudeEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String   // yyyy-MM-dd
  items     String[] // up to 3
  prompt    String?  // the prompt shown that day
  note      String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// Several check-ins per day are allowed; the latest is that day's mood.
model MoodEntry {
  id             String        @id @default(cuid())
  userId         String
  date           String        // yyyy-MM-dd
  mood           String        // happy | excited | calm | neutral | sad | anxious | stressed | angry
  intensity      Int           @default(3) // 1..5
  note           String?
  factors        String[]      @default([]) // e.g. work, sleep, family, health
  journalEntryId String?
  loggedAt       DateTime      @default(now())
  isDemo         Boolean       @default(false)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Album {
  id           String     @id @default(cuid())
  userId       String
  title        String
  description  String?
  coverMediaId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cover        MediaFile? @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  memories     Memory[]

  @@index([userId])
}

model Memory {
  id         String    @id @default(cuid())
  userId     String
  title      String
  caption    String?
  date       DateTime  // when it happened
  location   String?
  latitude   Float?
  longitude  Float?
  albumId    String?
  favorite   Boolean   @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  album      Album?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  media      MemoryMedia[]

  @@index([userId, date])
  @@index([userId, deletedAt])
}

model MemoryMedia {
  memoryId  String
  mediaId   String
  sortOrder Int       @default(0)
  memory    Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  media     MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([memoryId, mediaId])
}

model PhotoCollection {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      PhotoEntry[]

  @@index([userId])
}

// A photo in the Photo Diary (one media file each).
model PhotoEntry {
  id           String           @id @default(cuid())
  userId       String
  mediaId      String
  caption      String?
  tags         String[]         @default([])
  takenOn      String           // yyyy-MM-dd for browsing by date
  collectionId String?
  favorite     Boolean          @default(false)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media        MediaFile        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  collection   PhotoCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([userId, takenOn])
}

model BucketItem {
  id           String     @id @default(cuid())
  userId       String
  title        String
  description  String?
  category     String     @default("Personal") // Travel | Adventure | Career | Family | Learning | Lifestyle | Personal
  targetDate   DateTime?
  completedAt  DateTime?
  imageMediaId String?
  sortOrder    Float      @default(0)
  archivedAt   DateTime?
  deletedAt    DateTime?
  isDemo       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  image        MediaFile? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@index([userId, completedAt])
}

model TimelineEvent {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  date          DateTime
  datePrecision String    @default("day") // day | month | year
  category      String    @default("Personal") // Childhood | Education | Career | Family | Travel | Achievements | Personal
  deletedAt     DateTime?
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         TimelineMedia[]

  @@index([userId, date])
}

model TimelineMedia {
  eventId   String
  mediaId   String
  sortOrder Int           @default(0)
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media     MediaFile     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([eventId, mediaId])
}

// The user's written weekly review; the data summary is computed live.
model WeeklyReview {
  id            String   @id @default(cuid())
  userId        String
  weekStart     String   // yyyy-MM-dd of the week's first day (per weekStart setting)
  rating        Int?     // 1..5 how the week felt
  wins          String?
  challenges    String?
  lessons       String?
  nextWeekFocus String?
  aiSummary     String?  // optional AI-written summary (Phase 5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}


// ============================================================================
// My Finance, My Storage, My Security
// ============================================================================

model FinanceAccount {
  id             String        @id @default(cuid())
  userId         String
  name           String
  type           String        @default("bank") // cash | bank | card | wallet | savings
  openingBalance Int           @default(0) // minor units (paise, cents)
  color          String        @default("#13601F")
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[] @relation("TxAccount")
  transfersIn    Transaction[] @relation("TxToAccount")

  @@index([userId])
}

// Amounts are integers in minor units (e.g. paise) in the user's currency.
model Transaction {
  id             String          @id @default(cuid())
  userId         String
  type           String          // expense | income | transfer
  amount         Int             // > 0, minor units
  accountId      String?
  toAccountId    String?         // transfers
  category       String          @default("Other")
  paymentMethod  String?         // cash | upi | card | netbanking | wallet | other
  date           String          // yyyy-MM-dd
  note           String?
  payee          String?
  tags           String[]        @default([])
  receiptMediaId String?
  deletedAt      DateTime?
  isDemo         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        FinanceAccount? @relation("TxAccount", fields: [accountId], references: [id], onDelete: SetNull)
  toAccount      FinanceAccount? @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  receipt        MediaFile?      @relation(fields: [receiptMediaId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, category])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String   // expense category, or "*" for the whole month
  month     String   // yyyy-MM, or "*" for every month
  limit     Int      // minor units
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model DriveFolder {
  id        String        @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  color     String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    DriveFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DriveFolder[] @relation("FolderTree")
  files     DriveFile[]

  @@index([userId, parentId])
}

// A file in My Storage: a name and place for a stored MediaFile.
model DriveFile {
  id        String       @id @default(cuid())
  userId    String
  mediaId   String
  folderId  String?
  name      String
  starred   Boolean      @default(false)
  source    String       @default("upload") // upload | google_drive
  sourceId  String?      // Google Drive file id (dedupe imports)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     MediaFile    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  folder    DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, folderId])
}

// One-time recovery codes for two-step verification (stored as HMAC).
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
