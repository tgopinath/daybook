# --- Database (PostgreSQL) ---------------------------------------------
# Local: run `npm run db:local` (Prisma's embedded Postgres, no install needed)
# and paste the postgres:// URL it prints. Any PostgreSQL 14+ works.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# --- Auth ----------------------------------------------------------------
# Signs session tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# --- Vault encryption ----------------------------------------------------
# 32 random bytes, base64. Encrypts Personal Information fields at rest.
# Losing this key makes stored vault data unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=""

# --- Web Push (reminder notifications when the app is closed) ---------
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- AI ------------------------------------------------------------------
# anthropic (default) or openai. AI features show a "not configured" state
# until the matching key is set — no responses are ever faked.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional model override. Defaults: claude-sonnet-5 / gpt-4.1
AI_MODEL=""

# --- Attachments -----------------------------------------------------------
# Private directory for uploaded files (served only through authenticated API).
STORAGE_DIR="./storage"

# Optional: shared secret for an external cron hitting /api/cron/dispatch
CRON_SECRET=""

# --- Google sign-in (optional) ----------------------------------------
# OAuth 2.0 "Web application" client from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
# Leave empty to hide Google sign-in (the button shows as unavailable).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public base URL of the app, used to build the OAuth redirect URI (no trailing slash).
# Optional locally (derived from the request); set it in production, e.g. https://mydiary.example.com
APP_URL=""

# --- WhatsApp reminders (optional) ---------------------------------------
# Meta WhatsApp Cloud API. Leave empty to hide WhatsApp delivery (Settings shows it as unavailable).
# WHATSAPP_TOKEN: a permanent System User access token with whatsapp_business_messaging permission.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved message template names and language (see README → WhatsApp reminders).
WHATSAPP_REMINDER_TEMPLATE="mydiary_reminder"
WHATSAPP_VERIFY_TEMPLATE="mydiary_verify"
WHATSAPP_TEMPLATE_LANG="en"
